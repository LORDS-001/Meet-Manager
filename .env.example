# ---------------------------------------------------------------------------
# MeetManager configuration
# Copy this file to ".env" and fill in the values you need.
# Every value below is optional -- the app starts and runs without a .env file.
# ---------------------------------------------------------------------------

# Cosmetic default only. Everyone signs in with their own Google account and is
# identified by that, never by this - it is just what an install shows before
# anybody has signed in.
OWNER_EMAIL=adedokundaniel16@gmail.com

# Local server binding.
HOST=127.0.0.1
PORT=8000

# The address the app is reached at from outside. Leave unset locally: the
# redirect URI is then built from HOST/PORT as http://127.0.0.1:8000/auth/callback.
# Set it when hosting, where the process binds 0.0.0.0 on an arbitrary port and
# the derived URI would come out as http://0.0.0.0:10000/... , which Google rejects.
# PUBLIC_URL=https://meetmanager.onrender.com

# Signs the session cookie. Optional: unset, the app generates one and stores it
# in the database, so restarts keep you signed in. Set it when hosting, where the
# disk may be wiped, or when running more than one instance (they must agree).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=

# IANA timezone used for the UI, working hours and reminders.
# e.g. Africa/Lagos, Europe/London, America/New_York
TIMEZONE=Africa/Lagos

# --- Google Calendar OAuth (optional; needed for real calendar sync) --------
# Create an OAuth "Web application" client at https://console.cloud.google.com
# and add this exact redirect URI:  http://127.0.0.1:8000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Alternatively drop the downloaded credentials.json next to this file:
GOOGLE_CREDENTIALS_FILE=credentials.json

# --- Reminders --------------------------------------------------------------
REMINDER_MINUTES=30
# How many days ahead to pull events for.
SYNC_DAYS_AHEAD=30
# How often the calendar is re-synced, in seconds.
SYNC_INTERVAL_SECONDS=300

# --- Optional e-mail reminders (leave blank to disable) ---------------------
# For Gmail use an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=

# --- Scheduling preferences -------------------------------------------------
WORK_START=09:00
WORK_END=17:30
# 0=Monday ... 6=Sunday
WORK_DAYS=0,1,2,3,4
# Minimum breathing room between meetings, in minutes.
BUFFER_MINUTES=10
